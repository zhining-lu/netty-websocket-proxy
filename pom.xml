<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.netty-websocket-proxy</groupId>
	<artifactId>netty-websocket-proxy</artifactId>
	<version>1.3.5</version>
	<packaging>jar</packaging>

	<name>netty-websocket-proxy</name>
	<url>http://maven.apache.org</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- netty 版本统一在这里控制，各模块不再各自写版本号 -->
		<netty.version>4.2.19.Final</netty.version>
		<!--
			日志三件套统一在这里控制。log4j-api 与 log4j-core 必须同版本，
			log4j-slf4j-impl 也必须跟 core 对齐（历史上它落后到 2.13.2）。
		-->
		<log4j.version>2.26.1</log4j.version>
		<slf4j.version>1.7.36</slf4j.version>
		<!-- log4j2 的 AsyncLogger / AsyncRoot 需要 disruptor，2.20 起要求 3.4.x -->
		<disruptor.version>3.4.4</disruptor.version>
		<!-- bcprov-jdk15on 停在 1.70，1.71 起改名 bcprov-jdk18on（JDK 1.8+） -->
		<bcprov.version>1.86</bcprov.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
						<manifest>
							<addClasspath>true</addClasspath>
							<classpathPrefix></classpathPrefix>
							<mainClass>cn.wowspeeder.Application</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<descriptors>
						<descriptor>src/main/resources/package.xml</descriptor>
					</descriptors>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!--
			Netty 4.2 起 netty-all 已变成"空壳"聚合包：jar 里只有 META-INF，真实依赖全靠 pom 传递，
			并且会把 epoll / kqueue / io_uring / QUIC 的全平台 native 包一起拖进来（约 50 个 jar）。
			所以这里改成只声明本项目真正用到的模块，发行包体积与 4.1 时期的 netty-all 基本持平。
			以后新增 netty 用法时记得回来补模块，否则编译期会报「找不到包」。
		-->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-common</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-buffer</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-transport</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-resolver</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<!-- 4.2 把 MessageToMessageCodec / MessageToByteEncoder 等基类拆到了 netty-codec-base -->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-codec-base</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-codec-http</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-codec-socks</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-handler</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<!--
			epoll 分两个 jar：classes 提供 EpollSocketChannel / EpollIoHandler 等 Java 类，
			native 提供 .so。4.2 起 unix-common 的 native 代码已静态并入各 transport 的 .so，
			所以只需带 epoll 的 classifier 包；缺了它 Epoll.isAvailable() 会返回 false 并自动回退 NIO。
		-->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-transport-classes-epoll</artifactId>
			<version>${netty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-transport-native-epoll</artifactId>
			<version>${netty.version}</version>
			<classifier>linux-x86_64</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-transport-native-epoll</artifactId>
			<version>${netty.version}</version>
			<classifier>linux-aarch_64</classifier>
			<scope>runtime</scope>
		</dependency>
		<!--
			Bouncy Castle：encryption 包里的 7 种 shadowsocks 加密算法全靠它（JDK 没有 Camellia /
			SEED / Blowfish 的标准实现，且 BC 的轻量 API 可流式 processBytes，适合代理热路径）。
			注意 artifact 改名：bcprov-jdk15on 停在 1.70 不再更新，1.71 起叫 bcprov-jdk18on
			（"jdk18on" = JDK 1.8 以上，不是 Java 18）。1.86 的 base class 仍是 major 52，
			META-INF/versions 里是多 JDK 的 MR-Jar，Java 8 会忽略，不影响 source/target=1.8。
			包名 org.bouncycastle.* 未变，代码零改动。
		-->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>${bcprov.version}</version>
		</dependency>
		<!--
			tink：钉在 1.18.0 —— 这是最后一个 Java 8 字节码的版本（class major 52）；1.19.0 起
			pom 的 java.version 改成 11，会直接破掉本项目的 source/target=1.8 与 release 8 编译校验。
			1.18 的额外收益：
			  · 不再依赖 org.json（旧 json-20180813.jar 就是从 tink 1.5.0 传进来的），改用 gson；
			  · protobuf-java 从 3.11.1 升到 4.28.2（仍是 major 52），甩掉一批旧版 CVE。
			实际传递依赖只有 protobuf-java / jsr305 / error_prone_annotations 三个，
			google-http-client 不会进依赖树，所以 lib/ 里不会有 guava、httpclient、opencensus。
		-->
		<dependency>
			<groupId>com.google.crypto.tink</groupId>
			<artifactId>tink</artifactId>
			<version>1.18.0</version>
		</dependency>
		<!--
			日志：Netty 的 InternalLoggerFactory 探测顺序是 SLF4J → Log4J2 → JUL，
			所以实际链路是 InternalLogger → slf4j-api → log4j-slf4j-impl → log4j-core。
			源码里不要直接 import log4j / slf4j，统一用 io.netty.util.internal.logging.InternalLogger。
			2.x 每个 jar 的 base class 仍是 major 52（Java 8），META-INF/versions/9 是 MR-Jar，
			Java 8 会忽略，所以不破坏本项目的 1.8 编译目标。
		-->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-slf4j-impl</artifactId>
			<version>${log4j.version}</version>
		</dependency>
		<!-- 显式声明，避免跟着传递依赖漂到更老的 1.7.x -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lmax</groupId>
			<artifactId>disruptor</artifactId>
			<version>${disruptor.version}</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.8.9</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/commons-cli/commons-cli -->
		<dependency>
			<groupId>commons-cli</groupId>
			<artifactId>commons-cli</artifactId>
			<version>1.4</version>
		</dependency>

		<!--
			JUnit 5（Jupiter）。钉在 5.x 最后一版：5.x 仍是 Java 8 字节码，能配合 release 8 编译；
			JUnit 6 起要求 Java 17，会直接破坏本项目的 1.8 编译目标。
			test scope —— 不进发行包的 lib/，也不参与打包。
		-->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.14.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		编译目标必须锁在 Java 8 的 API 上，光锁字节码版本不够。

		坑：只配 source/target 时，JDK 9+ 的 javac 只是把产物标成 52 字节码，方法签名仍按
		新 JDK 的符号表解析。Java 9 起 ByteBuffer.position/limit/clear/flip 的返回值从
		Buffer 改成协变的 ByteBuffer，编译期就把调用绑到了新签名上，产物拿到 JDK 8 运行即
		NoSuchMethodError: java.nio.ByteBuffer.position(I)Ljava/nio/ByteBuffer。
		编译期不报错，运行期才炸，是本项目踩过的最贵的坑。

		解法：release 让 javac 对着 Java 8 的 ct.sym 做符号解析，这类越界 API 在编译期
		直接失败。但该选项是 JDK 9 才引入的，JDK 8 的 javac 不认识（invalid flag），
		所以按 JDK 版本二选一：9+ 走 release（compile-jdk9plus），JDK 8 只能退回
		source/target（compile-jdk8）。后者在 JDK 8 上是安全的，因为编译所用的 JDK 本身
		就是 8，不存在「按更高版本解析签名」的机会。
	-->
	<profiles>
		<profile>
			<id>compile-jdk8</id>
			<activation>
				<jdk>1.8</jdk>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<source>1.8</source>
							<target>1.8</target>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>compile-jdk9plus</id>
			<activation>
				<jdk>[9,)</jdk>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<release>8</release>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
